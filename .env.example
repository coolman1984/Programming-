# Gold Insight - Environment Configuration
# Copy this file to .env and fill in your API keys

# Gemini API Key for AI-powered deep analysis
# Get your API key from: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Metal Price API Key for live gold prices
# Get your API key from: https://metalpriceapi.com
VITE_METAL_API_KEY=your_metal_api_key_here

# Metals-API Key for real-time gold prices (primary source)
# Get your free API key from: https://metals-api.com
VITE_METALS_API_KEY=your_metals_api_key_here
